// 온빛 CMS 멀티테넌트 회원 스키마.
// 비밀번호는 저장하지 않는다. User.id는 Supabase Auth 사용자 id와 같다.
//
// Prisma 스키마로 표현할 수 없는 불변 조건은 첫 마이그레이션 SQL에서 강제한다.
// 1. role이 SUPER_ADMIN이면 company_id는 NULL이다.
// 2. role이 COMPANY_ADMIN 또는 EMPLOYEE이면 company_id는 NOT NULL이다.
// 3. login_id는 앞뒤 공백을 제거하고 소문자로 정규화한 값만 저장한다.
// 4. users.id는 auth.users.id를 참조한다.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  EMPLOYEE

  @@map("user_role")
}

/// 상담 고객의 현재 상태. 화면에서 고르는 고정 목록이다.
enum ConsultationStatus {
  /// 상담중
  IN_CONSULTATION
  /// 고민중
  CONSIDERING
  /// 부재
  ABSENT
  /// 거절
  REJECTED
  /// 수임
  RETAINED

  @@map("consultation_status")
}

/// 수임 사건의 유형. 화면에서 고르는 고정 목록이다.
enum CaseType {
  /// 개인회생
  PERSONAL_REHABILITATION
  /// 개인파산
  PERSONAL_BANKRUPTCY
  /// 개인워크아웃
  PERSONAL_WORKOUT
  /// 신속채무조정
  FAST_DEBT_ADJUSTMENT
  /// 새출발기금
  FRESH_START_FUND

  @@map("case_type")
}

/// 사건 진행 단계. 수임하면 서류수집부터 시작한다.
enum CaseProgressStage {
  /// 서류수집
  DOCUMENT_COLLECTION
  /// 보정
  CORRECTION
  /// 접수
  FILING
  /// 개시
  COMMENCEMENT
  /// 인가
  APPROVAL
  /// 종결
  CLOSURE

  @@map("case_progress_stage")
}

/// 분납 일정의 구분. 계약금은 한 줄이고, 회차는 분납 회수만큼 있다.
enum InstallmentKind {
  /// 계약금
  DEPOSIT
  /// 회차
  INSTALLMENT

  @@map("installment_kind")
}

/// 입금 수단. 화면에서 고르는 고정 목록이다.
enum PaymentMethod {
  /// 현금
  CASH
  /// 카드
  CARD

  @@map("payment_method")
}

/// 상담 고객이 들어온 경로. 화면에서 고르는 고정 목록이다.
enum InflowSource {
  /// 홈페이지
  HOMEPAGE
  /// 네이버
  NAVER
  /// 거래처 소개
  REFERRAL
  /// 전화
  PHONE
  /// 기타
  OTHER

  @@map("inflow_source")
}

/// 회사. 이후 고객 데이터와 업무 데이터는 이 레코드에 소속된다.
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// 회사를 구분하는 아이디. 사용자 로그인 아이디와 같은 문자 규칙을 따른다.
  loginId   String   @unique @map("login_id") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users     User[]
  teams     Team[]
  customers Customer[]

  @@map("companies")
}

/// CMS 회원. 인증 자격은 Supabase Auth가 관리하고, 이 테이블은 이름, 소속, 권한을 가진다.
model User {
  /// Supabase Auth 사용자 id. 애플리케이션에서 넣으며 자동 생성하지 않는다.
  id                 String   @id @db.Uuid
  /// 로그인 아이디. 이메일 로컬 파트 최대 길이(64)를 따른다.
  loginId            String   @unique @map("login_id") @db.VarChar(64)
  /// 화면에 표시하는 이름.
  name               String
  /// SUPER_ADMIN은 NULL. COMPANY_ADMIN과 EMPLOYEE는 필수.
  companyId          String?  @map("company_id") @db.Uuid
  role               UserRole
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company             Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// 소속 팀. 아직 없으면 NULL이다.
  teamId              String?              @map("team_id") @db.Uuid
  team                Team?                @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)
  ledTeams            Team[]               @relation("TeamLeader")
  assignedCustomers   Customer[]           @relation("CustomerAssignee")
  actedConsultations  Consultation[]       @relation("ConsultationActor")
  editedConsultations Consultation[]       @relation("ConsultationEditor")
  actedPayments       InstallmentPayment[] @relation("PaymentActor")
  actedRefunds        InstallmentRefund[]  @relation("RefundActor")

  @@index([companyId])
  @@index([teamId])
  @@map("users")
}

/// 회사 소속 팀. 팀을 구분하는 키는 id다.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  /// 팀장 사용자 id. 아직 정하지 않았으면 NULL이고, 정하면 이 팀 소속 직원이어야 한다.
  leaderId  String?  @map("leader_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leader  User?   @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members User[]  @relation("TeamMembers")

  @@index([companyId])
  @@index([leaderId])
  @@map("teams")
}

/// 회사의 상담 고객. 상담 상태와 유입처는 ENUM이고, 담당 직원과 다음 연락일은 아직 없을 수 있다.
model Customer {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  name          String
  /// 연락 전화번호. 하이픈 없이 숫자만 저장한다.
  phone         String             @db.VarChar(20)
  source        InflowSource
  /// 현재 상담 상태.
  status        ConsultationStatus @default(IN_CONSULTATION)
  /// 담당 사용자 id. 아직 없으면 NULL이다.
  /// 정하면 같은 회사의 활성 직원이어야 하고, 회사 담당 마스터는 본인을 담당으로 둘 수 있다.
  assigneeId    String?            @map("assignee_id") @db.Uuid
  /// 다음 연락일. 아직 없으면 NULL이다.
  nextContactOn DateTime?          @map("next_contact_on") @db.Date
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignee      User?          @relation("CustomerAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  consultations Consultation[]
  customerCase  CustomerCase?

  @@index([companyId])
  @@index([assigneeId])
  @@map("customers")
}

/// 고객의 상담 이력. 상담일자는 별도 컬럼 없이 created_at을 쓴다.
model Consultation {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  /// 상담 내용.
  content       String
  /// 다음 연락일. 아직 없으면 NULL이다.
  nextContactOn DateTime? @map("next_contact_on") @db.Date
  /// 이 상담 이력을 만든 사용자. 예전 행은 NULL이다.
  actorId       String?   @map("actor_id") @db.Uuid
  /// 이 상담 이력을 마지막으로 고친 사용자. 한 번도 고치지 않았으면 NULL이다.
  updatedById   String?   @map("updated_by_id") @db.Uuid
  /// 상담 일자.
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor     User?    @relation("ConsultationActor", fields: [actorId], references: [id], onDelete: Restrict)
  updatedBy User?    @relation("ConsultationEditor", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([updatedById])
  @@index([customerId, createdAt])
  @@map("consultations")
}

/// 수임으로 전환할 때 만드는 사건. 고객당 하나다.
model CustomerCase {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String            @unique @map("customer_id") @db.Uuid
  /// 계약일.
  contractedOn     DateTime          @map("contracted_on") @db.Date
  caseType         CaseType          @map("case_type")
  /// 수임료. 원 단위 정수.
  retainerFee      Int               @map("retainer_fee")
  /// 계약금. 원 단위 정수.
  deposit          Int
  /// 분납 회수.
  installmentCount Int               @map("installment_count")
  /// 첫 회차 납부일.
  firstPaymentOn   DateTime          @map("first_payment_on") @db.Date
  /// 진행 단계. 수임 직후는 서류수집이다.
  progressStage    CaseProgressStage @default(DOCUMENT_COLLECTION) @map("progress_stage")
  /// 다음 할 일. 수임 직후는 서류 요청이다.
  nextTask         String            @default("서류 요청") @map("next_task")
  /// 업무 기한. 아직 없으면 NULL이고 화면에는 미정이다.
  taskDueOn        DateTime?         @map("task_due_on") @db.Date
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  installments CustomerInstallment[]

  @@map("customer_cases")
}

/// 수임 사건의 납부 일정. 계약금 한 줄과 회차 줄을 함께 둔다.
model CustomerInstallment {
  id              String          @id @default(uuid()) @db.Uuid
  customerCaseId  String          @map("customer_case_id") @db.Uuid
  kind            InstallmentKind
  /// 계약금은 0, 회차는 1부터다.
  sequence        Int
  /// 납부 약속일.
  promisedOn      DateTime        @map("promised_on") @db.Date
  /// 예정액. 원 단위 정수.
  scheduledAmount Int             @map("scheduled_amount")
  /// 수납액. 원 단위 정수. 아직 입금이 없으면 0이다.
  receivedAmount  Int             @default(0) @map("received_amount")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerCase CustomerCase         @relation(fields: [customerCaseId], references: [id], onDelete: Restrict)
  payments     InstallmentPayment[]

  @@unique([customerCaseId, sequence])
  @@index([customerCaseId])
  @@map("customer_installments")
}

/// 분납 일정에 기록한 입금. 수납액은 이 금액의 합이다.
model InstallmentPayment {
  id            String        @id @default(uuid()) @db.Uuid
  installmentId String        @map("installment_id") @db.Uuid
  /// 입금액. 원 단위 정수.
  amount        Int
  /// 입금일.
  paidOn        DateTime      @map("paid_on") @db.Date
  method        PaymentMethod
  /// 입금을 등록한 사용자. 예전 행은 NULL이다.
  actorId       String?       @map("actor_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  installment CustomerInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  actor       User?               @relation("PaymentActor", fields: [actorId], references: [id], onDelete: Restrict)
  refunds     InstallmentRefund[]

  @@index([installmentId])
  @@index([actorId])
  @@map("installment_payments")
}

/// 입금 한 건에서 되돌린 금액. 환불가능금액은 입금액에서 환불 합계를 뺀 값이다.
model InstallmentRefund {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  /// 환불액. 원 단위 정수.
  amount     Int
  /// 환불일.
  refundedOn DateTime @map("refunded_on") @db.Date
  /// 환불 사유.
  reason     String
  /// 환불을 등록한 사용자. 예전 행은 NULL이다.
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment InstallmentPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor   User?              @relation("RefundActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([actorId])
  @@map("installment_refunds")
}
